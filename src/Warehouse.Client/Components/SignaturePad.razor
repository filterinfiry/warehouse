@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sigpad">
    <label class="sigpad-label">@Label</label>
    <canvas id="@_id" @ref="_canvas" width="500" height="180"></canvas>
    <div class="sigpad-actions">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAsync">Borrar</button>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Firma";

    /// <summary>Se dispara con el PNG en base64 (data URL) al capturar o null al borrar.</summary>
    [Parameter] public EventCallback<string?> OnCaptured { get; set; }

    private readonly string _id = "sig-" + Guid.NewGuid().ToString("N")[..8];
    private IJSObjectReference? _module;
    private ElementReference _canvas;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/signature.js");
            await _module.InvokeVoidAsync("init", _canvas);
        }
    }

    /// <summary>Captura la firma actual; devuelve null si está vacía.</summary>
    public async Task<string?> CaptureAsync()
    {
        if (_module is null) return null;
        var data = await _module.InvokeAsync<string?>("dataUrl", _id);
        await OnCaptured.InvokeAsync(data);
        return data;
    }

    private async Task ClearAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("clear", _id);
        await OnCaptured.InvokeAsync(null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { /* módulo ya liberado */ }
        }
    }
}
