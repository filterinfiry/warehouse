@page "/verification/{Id:guid}"
@inject WarehouseApi Api
@inject NavigationManager Nav

<PageTitle>Verificación de recepción</PageTitle>

@if (_session is null)
{
    <p><em>Cargando…</em></p>
}
else
{
    <div class="page-head">
        <div>
            <h1>Verificación de recepción</h1>
            <p class="text-muted mb-0">
                Orden <strong>@_session.Order?.ExternalRef</strong> — @_session.Order?.Customer
            </p>
        </div>
        @if (_session.Status == SessionStatus.Completed)
        {
            <span class="badge bg-success fs-6">Completada</span>
        }
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th class="text-center">Cant.</th>
                <th class="text-center">Estado</th>
                <th>Observación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in _session.Lines)
            {
                <tr class="@RowClass(l.Result)">
                    <td>
                        <strong>@l.Description</strong>
                        <div class="text-muted small">@l.ProductCode @(l.Barcode is null ? "" : $"· {l.Barcode}")</div>
                    </td>
                    <td class="text-center">@l.Quantity.ToString("0.##") @l.Unit</td>
                    <td class="text-center text-nowrap">
                        <button class="btn btn-sm @(l.Result == LineCheckResult.Ok ? "btn-success" : "btn-outline-success")"
                                disabled="@_locked" @onclick="() => SetResult(l, LineCheckResult.Ok)">OK</button>
                        <button class="btn btn-sm @(l.Result == LineCheckResult.Nok ? "btn-danger" : "btn-outline-danger")"
                                disabled="@_locked" @onclick="() => SetResult(l, LineCheckResult.Nok)">Mal</button>
                    </td>
                    <td>
                        <input class="form-control form-control-sm" placeholder="Observación…"
                               value="@l.Observation" disabled="@_locked"
                               @onchange="e => SetObservation(l, e.Value?.ToString())" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mb-3">
        <label class="form-label fw-semibold">Observación final</label>
        <textarea class="form-control" rows="2" @bind="_finalObservation" disabled="@_locked"></textarea>
    </div>

    @if (!_locked)
    {
        <div class="sign-grid">
            <div>
                <input class="form-control mb-1" placeholder="Nombre del supervisor" @bind="_supervisorName" />
                <SignaturePad @ref="_supervisorPad" Label="Firma supervisor" />
            </div>
            <div>
                <input class="form-control mb-1" placeholder="Nombre del transportista" @bind="_carrierName" />
                <SignaturePad @ref="_carrierPad" Label="Firma transportista" />
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-success btn-lg" disabled="@_saving" @onclick="Complete">
                @(_saving ? "Guardando…" : "Firmar y finalizar")
            </button>
        </div>
    }
    else
    {
        <div class="sign-grid">
            <div><label class="fw-semibold">Supervisor:</label> @_session.SupervisorName
                @if (_session.SupervisorSignature is not null) { <img class="sig-img" src="@_session.SupervisorSignature" /> }
            </div>
            <div><label class="fw-semibold">Transportista:</label> @_session.CarrierName
                @if (_session.CarrierSignature is not null) { <img class="sig-img" src="@_session.CarrierSignature" /> }
            </div>
        </div>
    }

    @if (_error is not null) { <div class="alert alert-danger mt-3">@_error</div> }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private VerificationSession? _session;
    private string? _finalObservation;
    private string? _supervisorName;
    private string? _carrierName;
    private SignaturePad? _supervisorPad;
    private SignaturePad? _carrierPad;
    private bool _saving;
    private bool _locked;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _session = await Api.GetVerificationAsync(Id);
        if (_session is not null)
        {
            _finalObservation = _session.FinalObservation;
            _supervisorName = _session.SupervisorName;
            _carrierName = _session.CarrierName;
            _locked = _session.Status == SessionStatus.Completed;
        }
    }

    private static string RowClass(LineCheckResult r) => r switch
    {
        LineCheckResult.Ok => "table-success",
        LineCheckResult.Nok => "table-danger",
        _ => ""
    };

    private async Task SetResult(VerificationLine l, LineCheckResult result)
    {
        l.Result = result;
        await Api.UpdateVerificationLineAsync(Id, l.Id, l.Result, l.Observation);
    }

    private async Task SetObservation(VerificationLine l, string? text)
    {
        l.Observation = text;
        await Api.UpdateVerificationLineAsync(Id, l.Id, l.Result, l.Observation);
    }

    private async Task Complete()
    {
        _saving = true; _error = null;
        var supSig = _supervisorPad is null ? null : await _supervisorPad.CaptureAsync();
        var carSig = _carrierPad is null ? null : await _carrierPad.CaptureAsync();

        var ok = await Api.CompleteVerificationAsync(Id, new CompleteVerificationRequest(
            _finalObservation, _supervisorName, supSig, _carrierName, carSig));

        if (ok) Nav.NavigateTo("/orders");
        else _error = "No se pudo finalizar la verificación.";
        _saving = false;
    }
}
